generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SupplierStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Supplier {
  id              String         @id @default(uuid())
  companyName     String
  vatId           String         @unique
  country         String
  contactEmail    String
  status          SupplierStatus @default(DRAFT)
  createdBy       String
  createdAt       DateTime       @default(now())
  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?
}
